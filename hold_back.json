{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin:.*$/"],
      "allowedVersions": "<=2.3.21"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["/^org\\.springframework\\.boot:.*$/"],
      "allowedVersions": "<5.0"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["/^org\\.springdoc:.*$/"],
      "allowedVersions": "<4.0"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["/com.ninja-squad:springmockk/"],
      "allowedVersions": "<6.0"
    }
  ]

}
