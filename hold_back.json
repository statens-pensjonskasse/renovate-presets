{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "matchPackagePatterns": ["^org\\.jetbrains\\.kotlin:.*$"],
      "allowedVersions": "<=2.3.21"
    },
    {
      "matchManagers": ["maven"],
      "matchPackagePatterns": ["^org\\.springframework\\.boot:.*$"],
      "allowedVersions": "<5.0"
    },
    {
      "matchManagers": ["maven"],
      "matchPackagePatterns": ["^org\\.springdoc:.*$"],
      "allowedVersions": "<4.0"
    },
    {
      "matchManagers": ["maven"],
      "matchPackagePatterns": ["com.ninja-squad:springmockk"],
      "allowedVersions": "<6.0"
    }
  ]

}
